[Unit]
Description=Subswarm API and provider jobs
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
User=subswarm
Group=subswarm
WorkingDirectory=/var/lib/subswarm
EnvironmentFile=/etc/subswarm/api.env
Environment=NODE_ENV=production
Environment=NODE_OPTIONS=--max-old-space-size=384
Environment=HOME=/var/lib/subswarm
Environment=XDG_CACHE_HOME=/var/cache/subswarm
ExecStart=/usr/bin/node /opt/subswarm/current/services/api/dist/index.js
Restart=on-failure
RestartSec=5
TimeoutStopSec=660
MemoryHigh=600M
MemoryMax=900M
CPUQuota=75%
TasksMax=64
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/subswarm /var/cache/subswarm

[Install]
WantedBy=multi-user.target
