{
  "name": "@subswarm/api",
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=.env src/index.ts",
    "build": "tsc",
    "start": "node --env-file-if-exists=.env dist/index.js",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test test/*.test.ts",
    "prepare:testnet": "tsx scripts/prepare-testnet.ts",
    "check:setup": "tsx --env-file-if-exists=.env scripts/check-setup.ts",
    "price:quest": "tsx scripts/price-quest.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.1159.0",
    "@hono/node-server": "2.1.5",
    "@modelcontextprotocol/sdk": "1.32.2",
    "@polkadot/api": "17.0.2",
    "@polkadot/util-crypto": "14.0.3",
    "@subswarm/shared": "1.0.0",
    "better-sqlite3": "13.0.3",
    "hono": "4.13.14",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/better-sqlite3": "9.6.0",
    "@types/node": "26.6.5",
    "tsx": "4.23.15",
    "typescript": "7.0.2"
  }
}
